#pragma code_page(65001)
#include <windows.h>
#include "../src/version.h"
#include "resource.h"

LANGUAGE LANG_TURKISH, SUBLANG_DEFAULT
IDI_APP ICON "icon.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VER_NUM
PRODUCTVERSION  VER_NUM
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041F04B0"
    BEGIN
      VALUE "CompanyName",      "TunnelDPI"
      VALUE "FileDescription",  "TunnelDPI"
      VALUE "FileVersion",      VER_STR
      VALUE "InternalName",     "TunnelDPI"
      VALUE "OriginalFilename", "TunnelDPI.exe"
      VALUE "ProductName",      "TunnelDPI"
      VALUE "ProductVersion",   VER_STR
      VALUE "LegalCopyright",   "Apache-2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x041F, 1200
  END
END
